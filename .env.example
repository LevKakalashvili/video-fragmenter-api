KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LOG4J_ROOT_LOGLEVEL=INFO
KAFKA_TOOLS_LOG4J_LOGLEVEL=INFO
KAFKA_TOPIC_IN=video.jobs
KAFKA_TOPIC_PROGRESS=video.progress
KAFKA_GROUP_ID=video-fragmenter
KAFKA_BATCH_SIZE=100
KAFKA_POLL_TIMEOUT_MS=1000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_LOG_LEVEL=info
MINIO_URL=http://localhost:9000
MINIO_REGION_NAME=us-east-1
MINIO_ADDRESSING_STYLE=path
MINIO_SECURE=false
MINIO_BUCKET=video-fragments
MINIO_CONNECT_TIMEOUT_SECONDS=3
MINIO_READ_TIMEOUT_SECONDS=8

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_STATE_TTL=86400

APP_PROJECT_NAME=video fragmenter service
APP_VERSION=0.0.1
APP_DEBUG=true
APP_MAX_VIDEOS_IN_PROGRESS=1
APP_MAX_CHUNK_PROCESSES_PER_VIDEO=5
APP_MAX_UPLOAD_CONCURRENCY=20
APP_CHUNK_SECONDS=120
APP_CHUNK_TYPE=time
APP_CHUNK_MODE=fast_keyframe_aligned
APP_MAX_FILE_BYTES=524288000
APP_SUPPORTED_VIDEO_FORMATS=mp4
APP_TMP_DIR_ROOT=/tmp
APP_FFMPEG_COMMAND=ffmpeg
APP_FFPROBE_COMMAND=ffprobe

APP_CONSOLE_SLEEP_TIME_SECONDS=0.1
APP_CONSOLE_RESOURCE_CHECK_TIMEOUT_SECONDS=5.0
